# Vedi README.md nella root del repo per come ottenere questi valori
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=   # es. act_1234567890 (anche senza "act_" va bene)

# Safety
META_DRY_RUN=true                    # true = nessuna scrittura reale, solo anteprima
META_MAX_DAILY_BUDGET_EUR=50         # tetto di sicurezza per singola campagna/ad set
META_MAX_LIFETIME_BUDGET_EUR=500
