# Copia questo file in .env (nella root del repo) e compila i valori che hai.
# Ogni piattaforma senza credenziali viene semplicemente saltata dai tool/report:
# non serve compilare tutto subito, si puo' procedere piattaforma per piattaforma.
#
# Ogni server MCP (mcp-meta-ads/, mcp-google-ads/, mcp-tiktok-ads/) puo' anche
# avere un proprio .env locale (copiando il rispettivo .env.example), che ha
# precedenza su questo se presente.

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_DRY_RUN=true
META_MAX_DAILY_BUDGET_EUR=50
META_MAX_LIFETIME_BUDGET_EUR=500

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_DRY_RUN=true
GOOGLE_MAX_DAILY_BUDGET_EUR=50
GOOGLE_MAX_LIFETIME_BUDGET_EUR=500

# --- TikTok ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_DRY_RUN=true
TIKTOK_MAX_DAILY_BUDGET_EUR=50
TIKTOK_MAX_LIFETIME_BUDGET_EUR=500

# --- HubSpot (per scripts/status_report.py) ---
# Impostazioni -> Integrazioni -> App private -> crea un'app con scope
# crm.objects.contacts.read
HUBSPOT_PRIVATE_APP_TOKEN=
